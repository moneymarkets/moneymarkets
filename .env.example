# ─────────────────────────────────────────────────────────────────────────────
# tradepro — environment template (spec §3.3)
# Copy to .env. .env is git-ignored and CI fails on any key material in tracked files.
# NEVER put a private key in any NEXT_PUBLIC_* variable.
# ─────────────────────────────────────────────────────────────────────────────

# ── Mode gates (A2.4, as amended 2026-09-03) ─────────────────────────────────
# Two independent switches. Submitting anything needs ALL THREE of these set.
# Reading mainnet needs none of them.
#   CHAIN  which network.
#   MODE   what the code may do. dryrun builds, validates and simulates, then stops.
CHAIN=testnet
MODE=dryrun
I_UNDERSTAND_THIS_USES_REAL_FUNDS=false

# ── Hard caps ────────────────────────────────────────────────────────────────
# These live in packages/core/src/chain/caps.ts as CODE. Setting them here can only
# TIGHTEN them; a larger value is ignored and the code cap stands. Listed so the
# effective limits are visible in one place.
#   MAX_ORDER_NOTIONAL_AUSD  1000000000  ($1,000.00, 6 decimals)
#   MAX_RELAYER_FLOAT_WEI    2000000000000000000  (2 MON)
#   live market allowlist    0x131a2e70a5b31a517a74b8c567149bc294470da9 (MON/AUSD)

# ── Local key material ───────────────────────────────────────────────────────
# Unlocks .secrets/*-keystore.json. Set this BEFORE running `pnpm generate-keys` to
# choose your own; otherwise one is generated and written to .secrets/PASSPHRASE.txt.
# Never commit either. .secrets/ is git-ignored.
RELAYER_KEYSTORE_PASSPHRASE=

# ── Explorer (server only) ───────────────────────────────────────────────────
# Free key from https://etherscan.io (Etherscan V2 covers chainid 143). Unblocks
# DECISIONS.md open item 1: verified source for the KuruForwarder implementation,
# or the proxy's transaction list. Run `pnpm close-item-1` once it is set.
ETHERSCAN_API_KEY=
MONADSCAN_API_KEY=

# ── Chain ────────────────────────────────────────────────────────────────────
RPC_URL_MONAD=https://testnet-rpc.monad.xyz

# Base mainnet, read-only. Used for the LayerZero AUSD leg: quoteSend against the
# OFT at 0x9CaB7Ede13dc56652E44D2404E969C212f22689b, dstEid 30390 (Monad). Read-only
# only — the Base-side send is a manual step, never automated from here.
BASE_RPC_URL=https://mainnet.base.org
RPC_URL_MONAD_MAINNET=

# ── Relayer (server only) ────────────────────────────────────────────────────
RELAYER_PRIVATE_KEY=
RELAYER_PORT=8787
# The hard cap is 20 MON in packages/core/src/chain/caps.ts. This may only
# tighten it; a larger value here is clamped back to the code cap.
RELAYER_MAX_FLOAT_MON=20
# Per-account gas sponsorship per rolling 24 hours. The code cap is PREFUND_MAX_MON
# (2 MON) in caps.ts; the hourly budgets derive from it. Blank means the code cap; a
# value here may only tighten it.
RELAYER_PREFUND_MAX_MON=

# The relayer account, used to read its MON float and enforce the cap. Optional: if
# unset, the address is taken from .secrets/relayer-keystore.json, which stores it in
# the clear. Setting it wrong does not let anything spend — it only makes the float
# alert watch an account the relayer cannot spend from, which is worse than no alert.
RELAYER_ADDRESS=

# Where a charged action's gas fee is paid (free actions, then gas at cost; DECISIONS.md
# D168/D169). REQUIRED: the relayer refuses to start while this is blank. It may be the
# relayer's own signing address for testing, which fees then land on the hot key; the
# relayer warns at every boot and /v1/health reports feeAddressIsHotKey while it is. Before
# production it must be an address whose key is not on the server. A token, the
# MarginAccount or another known contract is refused at boot.
RELAYER_FEE_ADDRESS=

# Bearer token for GET /v1/metrics. Leave empty and the endpoint is loopback-only,
# which is what a Prometheus sidecar wants. Set it only if you scrape across a network.
RELAYER_METRICS_TOKEN=

# Envio. HyperSync now rejects untokenised queries ("Your token is malformed"), so the
# indexer's bulk log fetching needs a free token from https://envio.dev. Without it the
# fallback is eth_getLogs, which this RPC caps at a 100-block range.
ENVIO_API_TOKEN=
RELAYER_FLOAT_ALERT_PCT=20
RELAYER_RATE_LIMIT_PER_ADDR_HOUR=60
RELAYER_RATE_LIMIT_PER_IP_HOUR=300
RELAYER_MAX_GAS=2000000
RELAYER_DEADLINE_MAX_SECONDS=300
RELAYER_DB_PATH=./data/relayer.sqlite

# ── Trade app (browser-visible values only) ──────────────────────────────────
NEXT_PUBLIC_RP_ID=localhost
NEXT_PUBLIC_RELAYER_URL=http://localhost:8787
NEXT_PUBLIC_CHAIN=testnet

# ── Funding integrations (server only) ───────────────────────────────────────
AURORA_API_KEY=
KURU_FLOW_REFERRER=
KURU_FLOW_REFERRER_BPS=30

# ── Market kit (operator; separate key from the relayer) ─────────────────────
# `pnpm generate-deployer` writes .secrets/deployer-keystore.json and prints the
# address. Put that address here: every dry run is built for it, and no dry run needs
# the key. DEPLOYER_PRIVATE_KEY is read only on the live signing path in send.ts —
# leave it empty until the moment you seed, and clear it again afterwards.
DEPLOYER_ADDRESS=
DEPLOYER_PRIVATE_KEY=

# The market-kit web UI (apps/market-kit/web). It signs through the local API using
# the deployer keystore, never a browser-held key, and its Sign button stays disabled
# unless MODE=live.
MARKET_KIT_PORT=8788

# ---- Funding rails (server-only; never NEXT_PUBLIC_) ----
#
# Every one is optional. A rail with no key still quotes where the vendor allows it
# unauthenticated, and says plainly what it cannot do without one — it never pretends.
#
# RELAY_API_KEY unlocks deposit addresses. Verified 2026-09-11: without it Relay answers
# "This request is missing an api key and cannot use a deposit address". Wallet-signed
# Relay quotes work without it.
RELAY_API_KEY=
RELAY_APP_FEE_RECIPIENT=
RELAY_APP_FEE_BPS=30

# Across asks integrators to identify themselves. Quotes work without it.
ACROSS_INTEGRATOR_ID=

# Circle Bridge Kit, if it turns out to need credentials. UNVERIFIED: not installed yet.
CIRCLE_API_KEY=

# No card, bank or centralized-exchange route exists in this product, by owner
# decision on 2026-09-11. The only non-bridge source is money already on Monad.
